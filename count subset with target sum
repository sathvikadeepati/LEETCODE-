//recursion  o(2^n) space -o(n)
class Solution {
    private int f(int index,int target,int[] arr){
        if(index == 0){
            if (target == 0  && arr[0]==0 ) return 2;
            if(target ==0 || arr[0]==target) return 1;
            return 0;
        }
        int notpick=f(index-1,target,arr);
        int pick=0;
        if(arr[index]<=target) pick=f(index-1,target-arr[index],arr);
        return  pick+notpick;
    }
    public int countSubset(int[] arr, int k) {
        // code here
        int n=arr.length;
        for(int x:arr){
            if(x<0) return 0;
        }
        return f(n-1,k,arr);
    }
}
///-----memorization o(n*s), space o(n*s)+o(n)
class Solution {
    private int f(int index,int target,int[] arr,int[][]dp){
        if(index == 0){
            if (target == 0  && arr[0]==0 ) return 2;
            if(target ==0 || arr[0]==target) return 1;
            return 0;
        }
        if(dp[index][target]!=-1){
            return dp[index][target];
        }
        int notpick=f(index-1,target,arr,dp);
        int pick=0;
        if(arr[index]<=target) pick=f(index-1,target-arr[index],arr,dp);
        return dp[index][target]= pick+notpick;
    }
    public int countSubset(int[] arr, int k) {
        // code here
        int n=arr.length;
        for(int x:arr){
            if(x<0) return 0;
        }
        int[][] dp=new int[n][k+1];
        for(int i=0;i<n;i++){
          Arrays.fill(dp[i],-1);   
        }
        return f(n-1,k,arr,dp);
    }
}
/// dp tabulation o(n*s) space -O(n*s)
class Solution {
    private int f(int target,int[] arr){
        int n=arr.length;
        int[][] dp=new int[n][target+1];
        if(arr[0] == 0){
            dp[0][0] = 2; // pick or not pick
        } else {
            dp[0][0] = 1;
            if(arr[0] <= target){
                dp[0][arr[0]] = 1;
            }
        }
        for(int i=1;i<n;i++){
            for(int s=0;s<=target;s++){
                int notpick=dp[i-1][s];
                int pick=0;
                if(arr[i]<=s) pick=dp[i-1][s-arr[i]];
                dp[i][s]= pick+notpick;
            }
        }
        return dp[n-1][target];
    }
    public int countSubset(int[] arr, int k) {
        // code here
        int n=arr.length;
        for(int x:arr){
            if(x<0) return 0;
        }
        return f(k,arr);
    }
}
///space o(n*s)  o(1)
class Solution {
    private int f(int target,int[] arr){
        int n=arr.length;
        int[] prev=new int[target+1];
        int[] curr=new int[target+1];
        if(arr[0] == 0){
            prev[0] = 2; // pick or not pick
        } else {
            prev[0] = 1;
            if(arr[0] <= target){
                prev[arr[0]] = 1;
            }
        }
        for(int i=1;i<n;i++){
            for(int s=0;s<=target;s++){
                int notpick=prev[s];
                int pick=0;
                if(arr[i]<=s) pick=prev[s-arr[i]];
                curr[s]= pick+notpick;
            }
            prev=curr.clone();
        }
        return prev[target];
    }
    public int countSubset(int[] arr, int k) {
        // code here
        int n=arr.length;
        for(int x:arr){
            if(x<0) return 0;
        }
        return f(k,arr);
    }
}
