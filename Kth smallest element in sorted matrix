class Solution {
     // bruteforce-Inserts all n² elements into a heap
        // Heap size = n²
        // Removes k−1 elements
        // Time Complexity
        // Insert n² elements → O(n² log n²)
        // Remove k elements → O(k log n²)
        //overall=0(n2logn2)
        //sc=O(n2)
