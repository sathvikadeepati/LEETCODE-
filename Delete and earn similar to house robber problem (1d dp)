    //------space optimization 
    private int solve(int[]points,int n){
        int prev1=points[1];
        int prev2=0;
        for(int i=2;i<=n;i++){
           int curr= Math.max(prev2+points[i],prev1);
           prev2=prev1;
           prev1=curr;
        }
        return prev1;
    }
    public int deleteAndEarn(int[] nums) {
        int maxval=0;
        for(int i=0;i<nums.length;i++){
            maxval=Math.max(maxval,nums[i]);
        }
        int [] points=new int[maxval+1];
        for(int n:nums){
            points[n]+=n;
        }
        return solve(points,maxval);
    }
