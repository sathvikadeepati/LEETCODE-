       //------ tabulation
       private int[] solve(TreeNode root){
          if(root==null) return new int[2];
          int[] leftnodes=solve(root.left);
          int[] rightnodes=solve(root.right);
          int[] options=new int[2];
          options[0]=root.val+leftnodes[1]+rightnodes[1];
          options[1]=Math.max(leftnodes[0],leftnodes[1])+Math.max(rightnodes[0],rightnodes[1]);
          return options;

       }
       public int rob(TreeNode root){
          int[] res=solve(root);
          return Math.max(res[0],res[1]);
       } 
