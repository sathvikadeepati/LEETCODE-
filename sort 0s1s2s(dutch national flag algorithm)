class Solution {
    public void sort012(int[] arr) {
        code here
        time complexity-O(n)
        space complexity-o(1)
        int ones=0;
        int zeros=0;
        int twos=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]==0){
                zeros+=1;
            }
            else if(arr[i]==1){
                ones+=1;
            }
            else{
                twos+=1;
            }
        }
        int index=0;
        for(int i=0;i<zeros;i++){
            arr[index++]=0;
        }
        for(int i=0;i<ones;i++){
            arr[index++]=1;
        }
        for(int i=0;i<twos;i++){
            arr[index++]=2;
        }
        / dutch national flag algorithm
        time and space -o(n) and space-o(1)
        int n=arr.length;
        int low=0;
        int mid=0;
        int high=n-1;
        while(mid<=high){
            if(arr[mid]==0){
                int temp=arr[mid];
                arr[mid]=arr[low];
                arr[low]=temp;
                low++;
                mid++;
            }
            else if(arr[mid]==1)  mid++;
            else {
              int temp=arr[mid];
                arr[mid]=arr[high];
                arr[high]=temp;
                high--;
            }
        }
    }
}
