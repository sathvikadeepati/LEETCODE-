    // second approach is using bs-tc-O(m*logmn) space-O(1);
    private int countpairs(int ele,int m,int n){
        int count=0;
        for(int i=1;i<=m;i++){
            count+=Math.min(ele/i,n);
        }
        return count;
    }
    public int findKthNumber(int m, int n, int k) {
        int low=1;
        int high=m*n;
        while(low<high){
            int mid=low+(high-low)/2;
            if(countpairs(mid,m,n)<k){
                low=mid+1;
            }
            else{
                high=mid;
            }
        }
        return low;
    }
}
