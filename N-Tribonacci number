    //------tabulationapproach 
    private int solve(int end){
        int[] dp=new int[end+1];
        dp[0]=0;
        dp[1]=1;
        dp[2]=1;
        for(int i=3;i<=end;i++){
            dp[i]=dp[i-1]+dp[i-2]+dp[i-3];
        }
      return dp[end];
    }
    public int tribonacci(int n) {
        if(n<=1) return n;
        return solve(n);
    }
